    "profile": {
      "items": [
        {
          "type": "HTML",
          "html": "Claude Floquet was an opening batsman who for some reason batted at No. 8 in his only Test - against England at Johannesburg in 1909-10 - scoring 1 and 11 not out.  He represented Transvaal and toured Australia with South Africa in 1910-11 but did not play in any of the Tests.  He died on the same day as President Kennedy was assassinated.\n<BR><B>Martin Williamson</B>"
        }
      ]
    },
    "notes": {
      "items": [
        {
          "type": "HTML",
          "html": "Brother of B.H. (Transvaal)."
        }
      ]
    },
