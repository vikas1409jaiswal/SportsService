    "profile": {
      "items": [
        {
          "type": "HTML",
          "html": "Trinidadian legspinner Imtiaz Ali was full of promise but as given only one chance to prove himself, on his home ground against India in 1975-76.  he took two wickets, but in an era when West Indies were reliant almost entirely on pace, he was never given another opportunity.\n<BR><B>Martin Williamson</B>"
        }
      ]
    },
