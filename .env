CRICKET_DB_PORT_MAP=5440:5432
HANGFIRE_DB_PORT_MAP=5441:5432
# Environment variables for CricketService
# Main CricketService DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=cricket_database
POSTGRES_PORT=5440
POSTGRES_HOST=localhost

# Hangfire DB
HANGFIRE_USER=postgres
HANGFIRE_PASSWORD=admin
HANGFIRE_DB=hangfire
HANGFIRE_PORT=5441
HANGFIRE_HOST=localhost

# API connection strings for Docker Compose
API_POSTGRES_CONN=Host=cricket-service-database;Port=5432;Username=postgres;Password=admin;Database=cricket_database
API_HANGFIRE_CONN=Host=hangfire-database;Port=5432;Username=postgres;Password=admin;Database=hangfire

# API environment and port
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5001
API_PORT_MAP=5001:5001
